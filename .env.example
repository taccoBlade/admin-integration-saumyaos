# ─── Supabase ────────────────────────────────────────────────────────────────
# Public URL (used by the browser client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key – safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key – SERVER-SIDE ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Convenience alias for server scripts
SUPABASE_URL=https://your-project.supabase.co

# ─── Admin ────────────────────────────────────────────────────────────────────
# Email address that is allowed to access /admin routes
ADMIN_ALLOWED_EMAIL=you@example.com

# ─── Backup ───────────────────────────────────────────────────────────────────
# Optional: HTTP PUT endpoint for scripts/backup.sh uploads
# Leave blank for local-only backups
BACKUP_BUCKET_URL=

# ─── Analytics ────────────────────────────────────────────────────────────────
# Google Analytics measurement ID (already embedded in layout.tsx)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
